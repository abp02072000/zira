# ==============================================================================
# ZIRA INVEST - MONOREPO ENVIRONMENT CONFIGURATION
# ==============================================================================

# Clerk Authentication & Identity
VITE_CLERK_PUBLISHABLE_KEY=pk_test_example_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_example_clerk_secret_key
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_example_clerk_webhook_secret

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=zira-invest-assets-rdc
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.zira-invest.cd
CLOUDFLARE_R2_ENDPOINT=

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=zira_admin
DB_PASSWORD=zira_secure_password
DB_NAME=zira_invest_db
DB_SSLMODE=disable

# Backend API URL
VITE_API_URL=http://localhost:8080/api/v1
PORT=3000
