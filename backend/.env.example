# ==============================================================================
# ZIRA INVEST - PRODUCTION BACKEND CONFIGURATION (GOLANG FIBER / CLEAN ARCHITECTURE)
# Ecosystem: Project Owners (Porteurs), Investors & Regulators (RDC / Kinshasa)
# ==============================================================================

# Server Configuration
PORT=8080
APP_ENV=development # development | staging | production
APP_NAME=ZIRA_Invest_API
APP_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:3000

# Clerk Authentication & Identity
# Get these from Clerk Dashboard (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_example_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_example_clerk_pub_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_example_clerk_webhook_secret

# Cloudflare R2 (S3-Compatible Object Storage for KYC, Documents, Images)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=zira-invest-assets-rdc
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://assets.zira-invest.cd
CLOUDFLARE_R2_ENDPOINT=https://your_cloudflare_account_id_here.r2.cloudflarestorage.com
CLOUDFLARE_R2_PRESIGNED_EXPIRATION_SECONDS=900 # 15 minutes for upload/download tokens

# PostgreSQL Persistence
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=zira_admin
DB_PASSWORD=zira_secure_password
DB_NAME=zira_invest_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# CORS & Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://zira-invest.cd
RATE_LIMIT_MAX=100
RATE_LIMIT_EXPIRATION_SECONDS=60

# Escrow & Financial Compliance (RDC / Kinshasa)
ESCROW_BANK_NAME=Rawbank_Kinshasa
ESCROW_ACCOUNT_NUMBER=01000-243-987654321-USD
ESCROW_REGULATORY_JURISDICTION=OHADA_Kinshasa_Gombe
